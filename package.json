{
  "name": "japa-gateway",
  "version": "0.1.0",
  "description": "A cloud-native API gateway built with Bun",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist",
    "test": "bun test",
    "bench": "bun run benchmarks/index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "docs": "typedoc --out docs/api src/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.48.0",
    "fast-jwt": "^3.3.2",
    "ioredis": "^5.3.2",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typedoc": "^0.25.7"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/japa-gateway.git"
  },
  "keywords": [
    "api-gateway",
    "microservices",
    "bun",
    "cloud-native",
    "proxy"
  ],
  "author": "",
  "license": "MIT"
}